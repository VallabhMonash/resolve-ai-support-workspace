{
  "name": "resolve-ai-support-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-powered support workspace using React, TypeScript, Node.js, GraphQL, PostgreSQL and RAG.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "drizzle-orm": "0.45.3",
    "graphql": "17.0.2",
    "graphql-yoga": "5.24.1",
    "pg": "8.23.0"
  },
  "scripts": {
    "compat:tokenizer": "node scripts/check-tokenizer.mjs",
    "compat:backend": "node scripts/check-backend-runtime.mjs",
    "compat:neon": "node --env-file=.env.local scripts/check-neon-runtime.mjs"
  }
}
